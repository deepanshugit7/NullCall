# Frontend Environment Variables

# REQUIRED for production (set this in Vercel dashboard under Settings > Environment Variables)
# This should point to your deployed backend URL (e.g. on Render.com or Railway.app)
VITE_BACKEND_URL=https://your-backend-url.onrender.com

# Local development (default fallback — no need to set this locally)
# VITE_BACKEND_URL=http://localhost:3001
